{
  "buildCommand": "cd campus-ai-frontend && npm install && npm run build",
  "outputDirectory": "campus-ai-frontend/dist",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/chat", "destination": "/api/chat.js" },
    { "source": "/api/quiz", "destination": "/api/quiz.js" },
    { "source": "/quiz", "destination": "/api/quiz.js" },
    { "source": "/api/code", "destination": "/api/code.js" },
    { "source": "/code", "destination": "/api/code.js" },
    { "source": "/api/studyplan", "destination": "/api/studyplan.js" },
    { "source": "/studyplan", "destination": "/api/studyplan.js" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/auth", "destination": "/api/auth.js" },
    { "source": "/api/sync", "destination": "/api/sync.js" },
    { "source": "/sync", "destination": "/api/sync.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
